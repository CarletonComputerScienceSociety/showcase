---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  cover: ImageMetadata | undefined;
  title: string;
}

const { cover, title } = Astro.props;
---

<div class="bg-canvas relative aspect-video overflow-hidden">
  {
    cover ? (
      <div class="h-full w-full">
        <Image
          src={cover}
          alt=""
          aria-hidden="true"
          width={cover.width}
          height={cover.height}
          loading="lazy"
          class="h-full w-full scale-125 object-cover blur-sm"
        />
        <Image
          src={cover}
          alt={`Cover image for ${title}`}
          width={cover.width}
          height={cover.height}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-contain"
        />
      </div>
    ) : (
      <div
        aria-hidden="true"
        class="bg-canvas flex h-full w-full items-center justify-center p-3"
      >
        <p class="text-ink text-center text-3xl font-bold">{title}</p>
      </div>
    )
  }
</div>
